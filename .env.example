# Example configuration only. Never commit real credentials.
# API requires DATABASE_URL and RABBITMQ_URL; worker requires RABBITMQ_URL.
# Supply process environment variables; .env is not loaded automatically.
# Npgsql format: Host=localhost;Port=5432;Database=owniverse;Username=owniverse;Password=<local-password>
# See backend/README.md and ai-worker/README.md.
DATABASE_URL=
# AMQP URI: amqp://<user>:<password>@localhost:5672/%2F (percent-encode credentials/vhost)
RABBITMQ_URL=
# Remaining variables are reserved for later tasks.
ASSET_STORAGE_PROVIDER=local

AI_PROVIDER=mock
MODEL_ID=
WORKER_CONCURRENCY=1
